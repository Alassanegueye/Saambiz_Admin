# URL de l'API backend SaamBiz
# Docker local (défaut) : le backend est exposé sur le port 5000.
#
# Le préfixe est /saambiz/v1 — l'adresse de référence. L'alias /saambiz sans
# version existe encore pour l'application mobile déjà installée, et répond
# avec un en-tête `Deprecation: true` : ne pas le viser au démarrage d'un
# nouvel environnement.
VITE_API_BASE_URL=http://localhost:5000/saambiz/v1
#
# Rien à renseigner ici pour la production : les valeurs livrées au navigateur
# vivent dans .env.production, versionné (voir .gitignore), que Vite charge
# tout seul au `npm run build`. Pour travailler en local contre l'API de
# production : `npm run dev:distant`, qui lit .env.distant.

# ── Mode démo ────────────────────────────────────────────────────────────────
# À 1, l'application tourne sur un jeu de données local : aucune requête n'est
# envoyée au backend. Sert à travailler le design avant le déploiement.
# Activable aussi à la volée par ?demo=1 dans l'URL (et ?demo=0 pour sortir).
VITE_DEMO=0

# Site vitrine, pour le lien de retour depuis la connexion vendeur.
VITE_SITE_URL=http://localhost:5199
