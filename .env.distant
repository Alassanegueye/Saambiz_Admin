# Dashboard lancé en local mais branché sur l'API en ligne (Render) :
#   npm run dev:distant
# On y voit les vrais comptes (vendeurs créés depuis le mobile ou le site),
# qui vivent dans la base de Render et pas dans la base PostgreSQL locale.
# Aucun secret ici : seulement l'adresse publique de l'API.
VITE_API_BASE_URL=https://saambiz-back-uj2z.onrender.com/saambiz/v1
VITE_ESPACE_VENDEUR_URL=https://app.saambiz.com
VITE_DEMO=0
VITE_SITE_URL=https://www.saambiz.com
