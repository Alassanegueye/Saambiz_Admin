# ─── Production — tableau de bord d'administration ──────────────────────────
# Utilisé par `npm run build` (Vite charge ce fichier en mode production).
# Le .env reste celui du développement local.
#
# Versionné volontairement : les variables VITE_* sont compilées dans le
# bundle livré au navigateur, donc publiques par construction. Les garder hors
# de git n'achetait aucune confidentialité et empêchait la CI de reconstruire
# le site — un build sans ces valeurs part avec les replis de développement,
# sans que rien ne le signale.

# Adresse COMPLÈTE de l'API, suffixe /saambiz/v1 compris : elle part
# directement en baseURL du client axios (src/service/api.js).
VITE_API_BASE_URL=https://saambiz-back-uj2z.onrender.com/saambiz/v1

# Espace vendeur, lié depuis l'administration. Sans cette valeur, le repli de
# src/constants/routes.js est http://localhost:5190 : en production le lien
# pointerait sur la machine du visiteur.
VITE_ESPACE_VENDEUR_URL=https://app.saambiz.com
